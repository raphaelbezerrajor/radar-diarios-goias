---
const { kicker, title, intro, actionHref, actionLabel } = Astro.props;
---

<div class="section-header">
  {kicker && <p class="section-kicker">{kicker}</p>}
  <div class="section-headline-row">
    <div>
      <h2>{title}</h2>
      {intro && <p class="section-intro">{intro}</p>}
    </div>
    {actionHref && actionLabel && (
      <a class="text-link" href={actionHref}>{actionLabel}</a>
    )}
  </div>
</div>
