---
import siteData from "../../generated/site-data.json";
import BaseLayout from "../../layouts/BaseLayout.astro";
import MetricStrip from "../../components/MetricStrip.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import { compactNumber } from "../../lib/format.js";

const baseHref = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const modules = [
  { title: "Coleta", text: "Fontes públicas, inventário e snapshots com baseline.", status: "Preparado" },
  { title: "Processamento documental", text: "Hash, extração, normalização e classificação com proveniência.", status: "Em evolução" },
  { title: "Radar de notícias", text: "Comparação histórica e fatos documentais que merecem publicação.", status: "Ativo", href: `${baseHref}goias/` },
  { title: "Apuração", text: "Hipóteses, perguntas, documentos e contraditório.", status: "Preparado" },
  { title: "Produção jornalística", text: "Título, olho, lead, detalhamento, contexto e fonte.", status: "Ativo" },
  { title: "Validação", text: "Nomes, datas, valores e páginas conferidos contra o documento.", status: "Protegido" },
  { title: "Bases municipais", text: "Trindade entra como primeiro módulo municipal completo.", status: "Ativo", href: `${baseHref}trindade/` },
  { title: "Monitoramento", text: "Cobertura, lacunas, regressões e qualidade da base.", status: "Ativo" },
  { title: "Publicação", text: "Matérias documentais verificadas entram diariamente no Pauteiro.", status: "Ativa" }
];
const metrics = [
  { label: "Matérias publicadas", value: compactNumber(siteData.metrics.publishedOfficialStories), note: "com fonte oficial" },
  { label: "Atos de Trindade", value: compactNumber(siteData.metrics.trindadeActs), note: "em formato jornalístico" },
  { label: "Processos do TCM", value: compactNumber(siteData.metrics.tcmStories), note: "em notícia" },
  { label: "Atualização", value: "Diária", note: "novos PDFs e atos" }
];
---

<BaseLayout title="Pauteiro | Como funciona a agência" description="Coleta, análise documental, seleção de pautas e publicação de notícias verificáveis a partir de fontes oficiais.">
  <section class="opening-band">
    <div class="shell opening-grid">
      <div class="opening-copy">
        <p class="section-kicker section-kicker-light">Agência de notícias documentais</p>
        <h1>Do documento público à matéria pronta para o leitor.</h1>
        <p class="page-summary">O Pauteiro acompanha diários oficiais e decisões públicas de Goiás. Mantemos os atos no acervo pesquisável e publicamos matérias sobre decisões que afetam dinheiro público, serviços, direitos e a vida dos municípios.</p>
        <div class="hero-actions">
          <a class="button-primary" href={`${baseHref}busca/`}>Pesquisar documentos</a>
          <a class="button-secondary button-on-dark" href={`${baseHref}trindade/`}>Abrir base Trindade</a>
        </div>
      </div>
      <aside class="opening-side">
        <p>Regra editorial</p>
        <strong>Documento primeiro. Notícia depois.</strong>
        <span>Sem copiar reportagens: a pauta nasce de Diários, atos públicos e decisões oficiais.</span>
      </aside>
    </div>
  </section>

  <MetricStrip items={metrics} />

  <section class="section-band content-auto" id="metodologia">
    <div class="shell">
      <SectionHeader
        kicker="Metodologia editorial"
        title="Como apuramos uma notícia documental"
        intro="Cada matéria pode ser conferida a partir do ato original e do contexto em que ele foi publicado."
      />
      <ol class="workflow-board">
        <li><span>01</span><div><strong>Preservamos os documentos.</strong> A coleta parte de fontes primárias, com prioridade para TCM-GO e TCE-GO. Registramos a origem, a edição e o hash do arquivo. Quando uma coleta fica incompleta, preservamos a última base validada.</div></li>
        <li><span>02</span><div><strong>Comparamos com o histórico.</strong> Buscamos o mesmo assunto, processo, contrato ou decisão no acervo e em fontes públicas. A cobertura da imprensa ajuda a localizar contexto. Os documentos oficiais sustentam os fatos sobre o ato.</div></li>
        <li><span>03</span><div><strong>Conferimos o que mudou.</strong> Distinguimos a data do ato da data em que ele saiu no Diário e identificamos seu estágio. Uma homologação confirma o resultado de uma licitação. A execução e o pagamento exigem evidência própria.</div></li>
        <li><span>04</span><div><strong>Publicamos com a fonte.</strong> A matéria identifica o ato e aponta para o original. Quando disponível, mostramos a página usada na apuração. A automação factual se limita ao que o documento expressa. Investigações, acusações e análises exigem revisão humana e contraditório quando aplicável.</div></li>
      </ol>
    </div>
  </section>

  <section class="section-band content-auto">
    <div class="shell">
      <SectionHeader
        kicker="Módulos"
        title="Uma agência organizada em nove etapas"
        intro="Cada módulo tem uma responsabilidade clara. Os dados municipais entram por uma interface estável e podem migrar de JSON para banco sem reescrever as páginas."
      />
      <div class="module-grid">
        {modules.map((module, index) => (
          module.href ? (
            <a class="module-card" href={module.href}>
              <span class="module-number">{String(index + 1).padStart(2, "0")}</span>
              <span class:list={["status-badge", module.disabled && "is-disabled"]}>{module.status}</span>
              <strong>{module.title}</strong>
              <p>{module.text}</p>
              <small>Abrir módulo →</small>
            </a>
          ) : (
            <article class:list={["module-card", module.disabled && "is-disabled"]}>
              <span class="module-number">{String(index + 1).padStart(2, "0")}</span>
              <span class:list={["status-badge", module.disabled && "is-disabled"]}>{module.status}</span>
              <strong>{module.title}</strong>
              <p>{module.text}</p>
            </article>
          )
        ))}
      </div>
    </div>
  </section>

  <section class="section-band section-band-newsprint content-auto" id="fluxo">
    <div class="shell">
      <SectionHeader
        kicker="Fluxo"
        title="Treze passos até a notícia publicada"
        intro="O processo preserva o original, evita duplicidade, produz a matéria e mantém a página usada como fonte disponível ao leitor."
      />
      <ol class="workflow-board">
        {[
          "Coletar novos documentos",
          "Detectar duplicidade por URL, identificador e hash",
          "Preservar o original",
          "Extrair e normalizar o texto",
          "Classificar município, órgão, tema e tipo",
          "Extrair pessoas, empresas, CNPJs, valores e datas",
          "Comparar com o histórico",
          "Selecionar o fato noticiável",
          "Isolar a página usada como fonte",
          "Preservar uma reprodução leve da página para conferência",
          "Escrever título, olho, lead e contexto",
          "Conferir nomes, números, datas e valores",
          "Publicar e manter o link para o original"
        ].map((step, index) => <li><span>{String(index + 1).padStart(2, "0")}</span><strong>{step}</strong></li>)}
      </ol>
    </div>
  </section>

  <section class="section-band section-band-contrast content-auto">
    <div class="shell split-grid">
      <div>
        <SectionHeader
          kicker="Primeira base municipal"
          title="Trindade integra a cobertura estadual"
          intro="Diário, atos, Câmara, orçamento e decisões de controle alimentam a mesma base de notícias e documentos do Pauteiro."
        />
        <div class="hero-actions">
          <a class="button-primary" href={`${baseHref}trindade/`}>Ver Trindade no Pauteiro</a>
          <a class="button-secondary" href={`${baseHref}busca/?city=Trindade`}>Pesquisar documentos de Trindade</a>
        </div>
      </div>
      <aside class="coverage-card">
        <p class="section-kicker">Linha de publicação</p>
        <h2>O acervo verificado vira notícia em escala.</h2>
        <p class="coverage-note">O Pauteiro publica o que está sustentado por fonte primária e identifica com clareza a origem, a data e o alcance de cada ato.</p>
      </aside>
    </div>
  </section>
</BaseLayout>

