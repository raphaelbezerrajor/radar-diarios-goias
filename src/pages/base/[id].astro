---
import records from "../../generated/site-records.json";
import siteData from "../../generated/site-data.json";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatCurrency, formatDate, withBase } from "../../lib/format.js";
import { buildBreadcrumbSchema, buildNewsArticleSchema } from "../../lib/editorial/seo.mjs";
const baseHref = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

export function getStaticPaths() {
  return records.map((record) => ({
    params: { id: record.slug },
    props: { record }
  }));
}

const { record } = Astro.props;
const imageSrc = withBase(record.image?.src);
const hasUsefulImage = Boolean(imageSrc && record.image?.kind !== "fallback");
const isStory = record.recordType === "story";
const isDocumentNews = record.publicationMode === "automatic_document_news";
const isRepositoryDocument = record.publicationMode === "repository_record";
const hasEditorialReading = isStory;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const homeUrl = new URL(baseHref, Astro.site).toString();
const searchUrl = new URL(`${baseHref}busca/`, Astro.site).toString();
const schemas = [buildBreadcrumbSchema([
  { name: "Pauteiro", url: homeUrl },
  { name: "Busca", url: searchUrl },
  { name: record.title, url: canonical }
])];
if (isStory) {
  schemas.push(buildNewsArticleSchema({
    canonical,
    story: {
      tituloEditorial: record.title,
      metadescricao: record.deck || record.summary,
      linhaFina: record.deck,
      dataPublicacao: record.publishedAt || record.date,
      dataAtualizacao: record.updatedAt || record.publishedAt || record.date,
      autor: "Pauteiro",
      imagem: hasUsefulImage ? {
        url: new URL(imageSrc, Astro.site).toString(),
        alt: record.image?.alt,
        credito: record.image?.credit
      } : null,
      fontes: record.sourceUrl ? [{ url: record.sourceUrl }] : []
    }
  }));
}
---

<BaseLayout title={`Pauteiro | ${record.title}`} description={record.deck || record.summary || record.title} schemas={schemas}>
  <article class="detail-shell shell">
    <a class="back-link" href={`${baseHref}busca/`}>Voltar para a busca</a>
    <div class="detail-grid">
      <div class="detail-main">
        <div class="story-kickers">
          <p class="section-kicker">{record.type} · {record.city}</p>
          {isDocumentNews
            ? <span class="archive-badge">Matéria baseada em documento oficial</span>
            : isStory
              ? <span class="archive-badge">Notícia documental</span>
              : isRepositoryDocument && <span class="archive-badge">Documento no repositório</span>}
        </div>
        <h1>{record.title}</h1>
        {record.deck && <p class="detail-deck">{record.deck}</p>}
        {isStory && (
          <div class="editorial-provenance">
            <strong>Publicado pelo Pauteiro</strong>
            <span>Matéria publicada em {formatDate(record.publishedAt || siteData.metadata.updatedAt)} · ato de {formatDate(record.date)}</span>
            {record.updatedAt && record.updatedAt !== record.publishedAt && <span>Análise atualizada em {formatDate(record.updatedAt)}</span>}
          </div>
        )}
        {hasUsefulImage && (
          <figure class="detail-figure">
            <img class="detail-image" src={imageSrc} alt={record.image?.alt || record.title} decoding="async" />
            {(record.image?.credit || record.image?.caption) && (
              <figcaption>
                {record.image?.caption && <span>{record.image.caption}</span>}
                {record.image?.credit && <small>Crédito: {record.image.credit}</small>}
              </figcaption>
            )}
          </figure>
        )}
        {record.summary && !record.paragraphs?.length && <p class="detail-summary">{record.summary}</p>}
        {record.keyFindings?.length ? (
          <section class="analysis-facts" aria-labelledby="analysis-facts-title">
            <h2 id="analysis-facts-title">O que o processo permite afirmar</h2>
            <dl>
              {record.keyFindings.map((fact) => (
                <div>
                  <dt>{fact.label}</dt>
                  <dd>{fact.value}</dd>
                </div>
              ))}
            </dl>
          </section>
        ) : null}
        {record.paragraphs?.length ? (
          <div class="detail-copy">
            {record.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        ) : null}
        {record.explainerSections?.length ? (
          <section class="story-explainer" aria-labelledby="story-explainer-title">
            <div class="story-explainer-heading">
              <p class="section-kicker">Entenda o documento</p>
              <h2 id="story-explainer-title">O fato, o efeito e o que falta conferir</h2>
            </div>
            <div class="story-explainer-grid">
              {record.explainerSections.map((section) => (
                <article>
                  <h3>{section.title}</h3>
                  <p>{section.text}</p>
                </article>
              ))}
            </div>
          </section>
        ) : null}
        {record.processTimeline?.length ? (
          <section class="analysis-timeline" aria-labelledby="process-timeline-title">
            <h2 id="process-timeline-title">Como o processo avançou</h2>
            <ol>
              {record.processTimeline.map((event) => (
                <li>
                  <time datetime={event.date}>{formatDate(event.date)}</time>
                  <span>{event.label}</span>
                </li>
              ))}
            </ol>
          </section>
        ) : null}
        {isStory && record.newsValue?.reasons?.length ? (
          <aside class="news-value-box">
            <strong>Por que importa</strong>
            <ul>{record.newsValue.reasons.filter((reason) => !reason.includes("rotina administrativa")).map((reason) => <li>{reason}</li>)}</ul>
          </aside>
        ) : null}
        {record.officialTitle && record.officialTitle !== record.title ? (
          <div class="editorial-note">
            <strong>Título do ato no documento:</strong> {record.officialTitle}
          </div>
        ) : null}
        {hasEditorialReading && (
          <p class="editorial-note">Esta matéria usa documento oficial como fonte primária. Datas, números, nomes, valores e estágio do ato são preservados; a íntegra continua disponível para conferência.</p>
        )}
      </div>
      <aside class="detail-side">
        <div class="hero-panel">
          <strong>{record.sourceFamily}</strong>
          <span>{record.sourceLabel}</span>
          <small>Data do ato: {formatDate(record.date)}</small>
          {isStory && <small>Publicação no Pauteiro: {formatDate(record.publishedAt || siteData.metadata.updatedAt)}</small>}
          {isStory && <small>Autoria editorial: Redação Pauteiro</small>}
          {isStory && <small>Estado editorial: publicada · fonte oficial</small>}
          {record.processNumber && <small>Processo: {record.processNumber}</small>}
          {isRepositoryDocument && <small>Estado editorial: repositório · sem destaque noticioso</small>}
        </div>
        {record.valueTotal ? (
          <div class="hero-panel">
            <strong>{formatCurrency(record.valueTotal)}</strong>
            <span>valor encontrado no recorte</span>
          </div>
        ) : null}
        {record.marker ? (
          <div class="hero-panel">
            <strong>Marcador</strong>
            <span>{record.marker}</span>
          </div>
        ) : null}
        <div class="detail-actions">
          {record.sourceUrl && (
            <a class="button-primary" href={record.sourceUrl} target="_blank" rel="noreferrer">{record.sourceActionLabel || "Abrir fonte original"} ↗</a>
          )}
          {record.processUrl && (
            <a class="button-secondary" href={record.processUrl} target="_blank" rel="noreferrer">Consultar processo completo ↗</a>
          )}
          <a class="button-secondary" href={`${baseHref}busca/?city=${encodeURIComponent(record.city || "")}&q=${encodeURIComponent(record.title)}`}>Buscar relacionados</a>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>
