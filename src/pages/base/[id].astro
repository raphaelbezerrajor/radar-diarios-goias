---
import { readFile } from 'node:fs/promises';
import BaseLayout from "../../layouts/BaseLayout.astro";
import Materia from "../../components/Materia.astro";
import { formatCurrency, formatDate, withBase } from "../../lib/format.js";
import { buildResearchChatUrl } from "../../lib/research-chat.mjs";
import { buildBreadcrumbSchema, buildDocumentArticleSchema, buildNewsArticleSchema, pauteiroAuthor } from "../../lib/editorial/seo.mjs";
const baseHref = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

export async function getStaticPaths() {
  const records = JSON.parse(await readFile('src/generated/site-records.json', 'utf8'));
  return records.filter(record => !record.reportingCandidate).map((record) => ({
    params: { id: record.slug },
    props: { record }
  }));
}

const { record } = Astro.props;
const imageSrc = withBase(record.image?.src);
const hasSourcePage = Boolean(imageSrc && record.image?.kind === "source-page");
const isStory = record.recordType === "story";
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const researchChatUrl = buildResearchChatUrl(record, canonical);
const homeUrl = new URL(baseHref, Astro.site).toString();
const searchUrl = new URL(`${baseHref}busca/`, Astro.site).toString();
const schemas = [buildBreadcrumbSchema([
  { name: "Pauteiro", url: homeUrl },
  { name: "Busca", url: searchUrl },
  { name: record.title, url: canonical }
])];
if (isStory) {
  const buildArticle = record.publishedAt ? buildNewsArticleSchema : buildDocumentArticleSchema;
  schemas.push(buildArticle({
    canonical,
    author: pauteiroAuthor,
    story: {
      tituloEditorial: record.title,
      metadescricao: record.deck || record.summary,
      linhaFina: record.deck,
      dataPublicacao: record.publishedAt,
      dataAtualizacao: record.updatedAt || record.publishedAt,
      imagem: null,
      fontes: [record.sourceUrl, ...(record.supportingSources || []).map((source) => source.url)].filter(Boolean).map((url) => ({ url }))
    }
  }));
}
---

<BaseLayout title={`Pauteiro | ${record.title}`} description={record.deck || record.summary || record.title} schemas={schemas} activeSection={record.sectionId}>
  {isStory ? <Materia record={record} researchChatUrl={researchChatUrl} /> : <article class="detail-shell shell">
    <a class="back-link" href={`${baseHref}busca/`}>Voltar para a busca</a>
    <div class="detail-grid">
      <div class="detail-main">
        <div class="story-kickers">
          <p class="section-kicker">{record.type} · {record.city}</p>
          <span class="archive-badge">Registro documental</span>
        </div>
        <h1>{record.reportingCandidate && record.officialTitle ? record.officialTitle : record.title}</h1>
        {record.deck && <p class="detail-deck">{record.deck}</p>}
        {record.summary && !record.paragraphs?.length && <p class="detail-summary">{record.summary}</p>}
        {record.keyFindings?.length ? (
          <section class="analysis-facts" aria-labelledby="analysis-facts-title">
            <h2 id="analysis-facts-title">Dados do ato</h2>
            <dl>
              {record.keyFindings.map((fact) => (
                <div>
                  <dt>{fact.label}</dt>
                  <dd>{fact.value}</dd>
                </div>
              ))}
            </dl>
          </section>
        ) : null}
        {record.paragraphs?.length && !(record.reportingCandidate && record.officialTitle && record.deck && record.keyFindings?.length) ? (
          <div class="detail-copy">
            {record.paragraphs.map((paragraph) => <p>{paragraph.replace(/^A matéria consta na edição /, "O ato consta na edição ")}</p>)}
          </div>
        ) : null}
        {record.processTimeline?.length ? (
          <section class="analysis-timeline" aria-labelledby="process-timeline-title">
            <h2 id="process-timeline-title">Como o processo avançou</h2>
            <ol>
              {record.processTimeline.map((event) => (
                <li>
                  <time datetime={event.date}>{formatDate(event.date)}</time>
                  <span>{event.label}</span>
                </li>
              ))}
            </ol>
          </section>
        ) : null}
      </div>
      <aside class="detail-side">
        {record.relatedReads?.length > 0 && <section class="detail-related"><h2>Leia também</h2><ul>{record.relatedReads.map(item => <li>
          <a href={withBase(item.path)}>{item.title}</a> <small>{formatDate(item.date)}</small></li>)}</ul></section>}
        <div class="hero-panel">
          <strong>{record.sourceFamily}</strong>
          <span>{record.sourceLabel}</span>
          <small>Data do ato: {formatDate(record.actDate || record.date)}</small>
          {record.actDate && <small>Publicação do documento: {formatDate(record.date)}</small>}
          {record.processNumber && <small>Processo: {record.processNumber}</small>}
        </div>
        {record.valueTotal ? (
          <div class="hero-panel">
            <strong>{formatCurrency(record.valueTotal)}</strong>
            <span>valor encontrado no recorte</span>
          </div>
        ) : null}
        {record.marker ? (
          <div class="hero-panel">
            <strong>Marcador</strong>
            <span>{record.marker}</span>
          </div>
        ) : null}
        <div class="detail-actions">
          <a class="button-secondary research-chat-button" href={researchChatUrl}>Investigar no chat ↗</a>
          <small class="research-chat-note">Abre uma nova conversa no aplicativo deste computador, com a fonte e a referência prontas para conferir. Revise a pergunta antes de enviar.</small>
          {record.sourceUrl && (
            <a class="button-primary" href={record.sourceUrl} target="_blank" rel="noreferrer">{record.sourceActionLabel || "Abrir fonte original"} ↗</a>
          )}
          {hasSourcePage && (
            <a class="button-secondary" href={imageSrc} target="_blank" rel="noreferrer" aria-label="Abrir reprodução da página usada como fonte">Conferir página citada ↗</a>
          )}
          {(record.supportingSources || []).map((source) => (
            <a class="button-secondary" href={source.url} target="_blank" rel="noreferrer">{source.label} ↗</a>
          ))}
          {record.processUrl && (
            <a class="button-secondary" href={record.processUrl} target="_blank" rel="noreferrer">Consultar processo completo ↗</a>
          )}
          <a class="button-secondary" href={`${baseHref}busca/?city=${encodeURIComponent(record.city || "")}&q=${encodeURIComponent(record.title)}`}>Buscar relacionados</a>
        </div>
      </aside>
    </div>
  </article>}
</BaseLayout>
