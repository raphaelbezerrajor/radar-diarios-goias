---
import siteData from "../generated/site-data.json";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import StoryCard from "../components/StoryCard.astro";
import { compactNumber, formatDate, withBase } from "../lib/format.js";

const baseHref = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const hero = siteData.leadStory;
const heroImage = withBase(hero.image?.src);
const heroLead = hero.paragraphs?.[0] || hero.summary;
const latest = siteData.timeline.stories
  .filter((story) => story.id !== hero.id && story.publicationMode !== "automatic_document_news")
  .slice(0, 6);
const control = siteData.controlFront.slice(0, 4);
const municipalities = siteData.actsFront.filter((story) => !/TC[EM]-GO/.test(story.sourceFamily || "")).slice(0, 6);
const quickCities = siteData.priorityMunicipalities.slice(0, 8).map((item) => ({
  label: item.name,
  href: `${baseHref}busca/?city=${encodeURIComponent(item.name)}&year=${encodeURIComponent(siteData.latestYear || "")}`
}));
---

<BaseLayout title="Pauteiro | Jornalismo baseado em documentos públicos" description="Notícias explicativas produzidas a partir de diários oficiais, contratos e decisões públicas de Goiás.">
  <section class="newsroom-strip">
    <div class="shell newsroom-strip-inner">
      <p><strong>Atualizado em {formatDate(siteData.metadata.updatedAt)}</strong><span>Goiás · documentos oficiais conferidos</span></p>
      <a href={`${baseHref}busca/`}>Pesquisar toda a base →</a>
    </div>
  </section>

  <section class="hero-band hero-band-first">
    <div class="shell hero-grid">
      <article class="hero-lead">
        <a class="hero-image" href={withBase(hero.path)} aria-label={`Abrir: ${hero.title}`}>
          <img src={heroImage} alt={hero.image?.alt || hero.title} fetchpriority="high" decoding="async" />
        </a>
        <div class="hero-copy">
          <p class="section-kicker">Manchete</p>
          <div class="hero-meta hero-meta-top"><span>{hero.city}</span><span>{hero.type}</span><span>{formatDate(hero.date)}</span></div>
          <h1>{hero.title}</h1>
          <p class="hero-deck">{hero.deck}</p>
          {heroLead && <p class="hero-summary">{heroLead}</p>}
          <div class="hero-actions">
            <a class="button-primary" href={withBase(hero.path)}>Ler matéria</a>
            <a class="button-secondary" href={`${baseHref}linha-do-tempo/`}>Ver as últimas</a>
          </div>
        </div>
      </article>
      <aside class="hero-side" aria-label="Outras notícias em destaque">
        <div class="rail-heading"><p class="section-kicker">Em destaque</p><h2>Outros assuntos importantes</h2></div>
        <div class="stack-list">
          {siteData.heroSidebar.map((record) => (
            <a class="stack-item" href={withBase(record.path)}><span class="pill">{record.city}</span><strong>{record.title}</strong><small>{record.type} · {formatDate(record.date)}</small></a>
          ))}
        </div>
      </aside>
    </div>
  </section>

  <section class="section-band section-band-newsprint content-auto">
    <div class="shell">
      <SectionHeader kicker="Últimas notícias" title="O que apareceu nos documentos públicos" intro="Seleção por interesse público, impacto e atualidade. Atos rotineiros permanecem no acervo, sem disputar espaço com notícia." actionHref={`${baseHref}linha-do-tempo/`} actionLabel="Ver todas as notícias" />
      <div class="story-grid story-grid-three">{latest.map((record) => <StoryCard record={record} compact={true} showSummary={true} imageMode="auto" />)}</div>
    </div>
  </section>

  <section class="section-band content-auto">
    <div class="shell section-split-editorial">
      <div>
        <SectionHeader kicker="Controle público" title="Decisões de TCM e TCE, sem juridiquês" intro="Multas, alertas, cautelares e correções são apresentados com o estágio do processo e os limites do que a decisão permite afirmar." actionHref={`${baseHref}controle/`} actionLabel="Abrir Controle" />
        <div class="brief-list">{control.map((record) => <StoryCard record={record} compact={true} showSummary={true} imageMode="hide" />)}</div>
      </div>
      <aside class="editorial-principle">
        <p class="section-kicker">Nosso método</p><h2>Fato primeiro. Contexto logo depois.</h2>
        <p>Cada matéria responde o que aconteceu, quem está envolvido, quanto dinheiro aparece e o que ainda não pode ser concluído.</p>
        <dl><div><dt>{compactNumber(siteData.metrics.repositoryRecords)}</dt><dd>documentos pesquisáveis</dd></div><div><dt>{compactNumber(siteData.timeline.total)}</dt><dd>notícias relevantes em {siteData.timeline.year}</dd></div></dl>
        <a class="button-secondary" href={`${baseHref}pauteiro/`}>Como o Pauteiro trabalha</a>
      </aside>
    </div>
  </section>

  <section class="section-band section-band-contrast content-auto">
    <div class="shell">
      <SectionHeader kicker="Municípios" title="Dinheiro, serviços e decisões perto do leitor" intro="Contratos, licitações, orçamento, obras e políticas públicas entram em uma única cobertura municipal — sem portais paralelos." actionHref={`${baseHref}municipios/`} actionLabel="Abrir Municípios" />
      <div class="story-grid story-grid-three">{municipalities.map((record) => <StoryCard record={record} compact={true} showSummary={true} imageMode="auto" />)}</div>
      <div class="city-shortcuts" aria-label="Acesso rápido por município">{quickCities.map((item) => <a href={item.href}>{item.label}</a>)}</div>
    </div>
  </section>

  <section class="section-band compact-closing">
    <div class="shell source-note-panel">
      <div><p class="section-kicker">Acervo verificável</p><h2>A notícia abre o documento que a sustenta.</h2></div>
      <p>Os registros de 2025 e 2026 continuam na mesma busca. O que tem valor-notícia recebe leitura explicativa; o restante permanece como documento de consulta.</p>
      <a class="button-primary" href={`${baseHref}busca/?year=all`}>Explorar a base</a>
    </div>
  </section>
</BaseLayout>
