---
import siteData from "../../generated/site-data.json";
import BaseLayout from "../../layouts/BaseLayout.astro";
import StoryCard from "../../components/StoryCard.astro";
import ControlDiaries from '../../components/ControlDiaries.astro';
import SectionHeader from "../../components/SectionHeader.astro";
import { compactNumber } from "../../lib/format.js";
---

<BaseLayout title="Controle público | Pauteiro" description="Decisões do TCM-GO e TCE-GO explicadas com contexto e fonte oficial.">
  <section class="section-band page-intro-band"><div class="shell page-intro"><p class="section-kicker">TCM-GO e TCE-GO</p><h1>Fiscalização pública explicada com precisão.</h1><p class="page-summary">O Pauteiro diferencia investigação, parecer, cautelar, multa, débito e decisão final. Divergência contábil não é tratada automaticamente como dano, e contrato não é confundido com pagamento.</p></div></section>
  <section class="section-band"><div class="shell"><SectionHeader kicker="Acompanhamento diário" title="TCM e TCE: documentos mais recentes" intro="Consulte as edições preservadas e acompanhe a cobertura dos dois tribunais." /><ControlDiaries sources={siteData.controlCoverage} /></div></section>
  <section class="section-band section-band-newsprint"><div class="shell"><SectionHeader kicker="Matérias explicativas" title="Processos que merecem atenção" intro={`${compactNumber(siteData.controlFront.length)} matérias selecionadas, da mais recente para a mais antiga.`} /><div class="story-grid story-grid-three">{siteData.controlFront.map((record) => <StoryCard record={record} compact={true} showSummary={true} />)}</div></div></section>
  {siteData.controlCoverage.map(source => <section class="section-band"><div class="shell"><SectionHeader kicker={source.label} title="Registros recentes no acervo" intro="Atos extraídos dos documentos oficiais. A presença no diário não significa, por si só, irregularidade ou condenação." /><div class="story-grid story-grid-three">{source.recentRecords.map(record => <StoryCard record={record} compact={true} />)}</div></div></section>)}
</BaseLayout>
