---
import Caderno from '../../components/Caderno.astro';
import { coverPageProps, totalCoverPages } from '../../lib/editorial/caderno-pages.js';
export function getStaticPaths() {
  return Array.from({length:totalCoverPages-1}, (_, i) => ({
    params:{pagina:String(i+2)}, props:coverPageProps(i+2)
  }));
}
---
<Caderno {...Astro.props}/>
