---
import "../styles/global.css";

const {
  title = "Pauteiro",
  description = "Documentos públicos, radar de pautas e bases municipais integradas.",
  schemas = []
} = Astro.props;
const baseHref = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const portalTrindade = "https://trindade-aberta.raphaelbezerra.chatgpt.site";
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(`${baseHref}assets/trindade/og.png`, Astro.site);
const currentPath = Astro.url.pathname;
const navItems = [
  { label: "Capa", href: baseHref, active: currentPath === baseHref },
  { label: "Plataforma", href: `${baseHref}pauteiro/`, active: currentPath.includes("/pauteiro/") },
  { label: "Painel Diário", href: `${baseHref}goias/`, active: currentPath.includes("/goias/") },
  { label: "Trindade", href: `${baseHref}trindade/`, active: currentPath.includes("/trindade/") },
  { label: "Buscar", href: `${baseHref}busca/`, active: currentPath.includes("/busca/") }
];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0d211c" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Ir para o conteúdo</a>
    <header class="site-header">
      <div class="site-topline">
        <div class="shell topline-bar">
          <span>Plataforma editorial · documentos, pautas e bases municipais</span>
          <a href={portalTrindade}>Abrir Portal Trindade ↗</a>
        </div>
      </div>
      <div class="shell header-bar">
        <a class="brand" href={baseHref}>
          <span class="brand-mark">PAUTEIRO</span>
          <span class="brand-copy">documento, contexto e pauta</span>
        </a>
        <nav class="site-nav" aria-label="Principal">
          {navItems.map((item) => (
            <a href={item.href} aria-current={item.active ? "page" : undefined}>{item.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main id="conteudo">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell footer-grid">
        <div>
          <strong>PAUTEIRO</strong>
          <p>Coleta, organiza e transforma documentos públicos em pauta verificável.</p>
        </div>
        <div>
          <strong>Leitura responsável</strong>
          <p>Um vínculo documental não constitui acusação. Confirme sempre a fonte original.</p>
        </div>
        <div class="footer-links">
          <a href={`${baseHref}busca/`}>Buscar na base</a>
          <a href={`${baseHref}pauteiro/`}>Conhecer a plataforma</a>
          <a href={portalTrindade}>Portal Trindade ↗</a>
        </div>
      </div>
    </footer>
  </body>
</html>
