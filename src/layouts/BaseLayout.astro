---
import "../styles/global.css";
import "../styles/caderno.css";
import "../styles/caderno-internas.css";
import { sections } from "../lib/editorial/distribution.mjs";
import { formatDate } from "../lib/format.js";
import siteData from "../generated/site-data.json";
import { firstArchivePage } from "../lib/editorial/caderno-pages.js";

const {
  title = "Pauteiro",
  description = "Notícias produzidas a partir de documentos públicos e fontes oficiais.",
  activeSection = "", schemas = []
} = Astro.props;
const baseHref = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(`${baseHref}assets/trindade/og.png`, Astro.site);
const currentPath = Astro.url.pathname;
const navItems = [{id:'capa', label:'Capa', href:baseHref}, ...Object.entries(sections).map(([id,label]) => ({id,label,href:baseHref+'editorias/'+id+'/'}))];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="stylesheet" href={baseHref+'assets/caderno/papel.css'} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0d211c" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Ir para o conteúdo</a>
    <div class="caderno"><header>
      <div class="topline"><div class="shell"><span>Goiás <i aria-hidden="true"></i> Agência de notícias documentais</span><span class="edition-date">Acervo atualizado em {formatDate(siteData.metadata.updatedAt)}</span></div></div>
      <div class="shell mast">
        <a class="brand" href={baseHref} aria-label="Pauteiro, capa">Pauteiro<span>.</span></a>
        <div class="mast-links"><a class="territory" href={baseHref+'municipios/'}>Municípios</a><a class="search" href={baseHref+'busca/'} aria-label="Buscar no acervo"><span class="magnifier" aria-hidden="true"></span><span>Buscar<span class="search-extra"> no acervo</span></span></a></div>
      </div>
      <nav class="shell tabs" aria-label="Capa e editorias">
        {navItems.map(item => <a href={item.href} data-section={item.id} aria-current={currentPath === item.href ? 'page' : item.id === activeSection ? 'location' : undefined}><i aria-hidden="true"></i>{item.label}</a>)}
      </nav>
    </header></div>
    <main id="conteudo" class={currentPath === baseHref || currentPath.startsWith(baseHref+'editorias/') || currentPath.startsWith(baseHref+'capa/') ? undefined : 'caderno-interno'}>
      <slot />
    </main>
    <footer class="site-footer">
      <slot name="pager" />
      <div class="shell footer-grid">
        <div>
          <strong>PAUTEIRO</strong>
          <p>Uma agência que transforma diários oficiais e documentos públicos em notícias verificáveis.</p>
        </div>
        <div>
          <strong>Leitura responsável</strong>
          <p>Um vínculo documental não constitui acusação. Confirme sempre a fonte original.</p>
        </div>
        <div class="footer-links">
          {firstArchivePage && <a href={baseHref+'capa/'+firstArchivePage+'/'}>Arquivo de matérias</a>}
          <a href={`${baseHref}busca/`}>Buscar na base</a>
          <a href={`${baseHref}linha-do-tempo/`}>Últimas notícias</a>
          <a href={`${baseHref}municipios/`}>Municípios</a>
          <a href={baseHref+"goias/"}>Goiás</a><a href={baseHref+"controle/"}>Tribunais de contas</a><a href={baseHref+"pauteiro/"}>Como trabalhamos</a>
        </div>
      </div>
    </footer>
  </body>
</html>
