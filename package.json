{
  "name": "pauteiro-site",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "node scripts/build-site-data.mjs && astro dev",
    "sync:trindade": "node scripts/sync-trindade-data.mjs",
    "news:previews": "python scripts/render-source-previews.py --limit 24",
    "news:july-previews": "python scripts/render-july-previews.py --limit 24",
    "news:control-previews": "python scripts/render-control-previews.py",
    "editorial:queue": "node scripts/build-curation-queue.mjs",
    "build:data": "node scripts/build-site-data.mjs",
    "build": "node scripts/build-site-data.mjs && astro build",
    "validate:news": "node scripts/validate-news-policy.mjs",
    "validate": "node scripts/validate-news-policy.mjs && node scripts/validate-site.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "test": "pnpm run test:unit && pnpm build && pnpm validate",
    "preview": "astro preview"
  },
  "devDependencies": {
    "astro": "^5.0.0"
  }
}
